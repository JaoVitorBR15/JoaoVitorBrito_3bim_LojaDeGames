# Copie este arquivo para .env e preencha com os dados do seu PostgreSQL.
DB_HOST=localhost
DB_PORT=5432
DB_USER=seu_usuario_postgres
DB_PASSWORD=sua_senha_postgres
DB_NAME=gamestore

# Gere um segredo longo e aleatório para assinar os cookies.
COOKIE_SECRET=SUBSTITUA_POR_UM_SEGREDO_ALEATORIO_LONGO
NODE_ENV=development
PORT=3001

# Usado apenas pelo script npm run admin:criar
ADMIN_NAME=Administrador GameStore
ADMIN_EMAIL=admin@gamestore.com
ADMIN_INITIAL_PASSWORD=DefinaUmaSenhaForteAqui
